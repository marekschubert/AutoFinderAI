{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=autofinder.db"
  },
  "Ai": {
    "_comment": "Free-tier OpenRouter models only, by default, to avoid cost. Edit this list (and DefaultModel) to change the model catalogue - no rebuild needed, just restart the app. ApiKey is intentionally absent here; it comes from the OPENROUTER_API_KEY environment variable (.env locally).",
    "DefaultModel": "nvidia/nemotron-3-super-120b-a12b:free",
    "Models": [
      "nvidia/nemotron-3-super-120b-a12b:free",
      "google/gemma-4-26b-a4b-it:free",
      "nvidia/nemotron-3-nano-30b-a3b:free",
      "openai/gpt-oss-20b:free"
    ],
    "TimeoutSeconds": 30,
    "MaxCandidates": 200,
    "DefaultLimit": 10,
    "MaxLimit": 50,
    "AllowKeywordFallback": false,
    "Temperature": 0,
    "MaxRepairRetries": 1
  },
  "Jwt": {
    "Key": "",
    "Issuer": "AutoFinderAI",
    "ExpiryMinutes": 60
  },
  "Crawler": {
    "MaxPages": 2,
    "RequestDelayMs": 750
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "AllowedHosts": "*"
}
