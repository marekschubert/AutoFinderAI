# Copy to .env and fill in real values. .env is git-ignored.
# This same file is used both by `dotnet run` (loaded manually by Program.cs) and by
# `docker compose` (loaded automatically because it sits next to docker-compose.yml).

# OpenRouter LLM gateway. The model catalogue (Ai:Models / Ai:DefaultModel) is configured in
# appsettings.json (one file, no rebuild needed) - only the secret key lives here.
OPENROUTER_API_KEY=

# JWT auth (required - the API refuses to start in Docker without Jwt__Key set)
Jwt__Key=change-me-to-a-long-random-secret-min-32-chars
Jwt__Issuer=AutoFinderAI
Jwt__ExpiryMinutes=60

# Data (leave unset locally - appsettings.json already points at ./autofinder.db;
# the /data path is only valid inside the Docker container, set by docker-compose.yml)
# ConnectionStrings__Default=Data Source=/data/autofinder.db

# Crawler (optional overrides - only read by `dotnet run`, not by Docker)
Crawler__MaxPages=2
Crawler__RequestDelayMs=750
